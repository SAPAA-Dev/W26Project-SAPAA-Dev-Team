%% SAPAA system architecture, Fall 2026.
%% The diagram shows the system as the code is today. Items with the "proposed" style do not exist in the code.
%% Evidence: webapp/utils/supabase/*.ts, webapp/app/api/**, webapp/app/auth/**, webapp/middleware.ts,
%% webapp/lib/pdf/*.ts, webapp/utils/admin-actions.ts, webapp/utils/media/s3Delete.ts,
%% webapp/utils/kml-import-actions.ts, webapp/lib/map/kmlImport.ts, webapp/scripts/local_*.js,
%% FNR/src/services/*.ts, FNR/src/screens/*.tsx, .github/workflows/*.yaml
%% Checked against origin/main 9009d0d on October 11, 2026. The googleSheets/ client was removed in c7f7cb4.
flowchart TB
    subgraph Legend["Legend"]
        direction LR
        LegendComponent["Component in this repository"]
        LegendStore[("Data store")]
        LegendExternal{{"External service"}}
        LegendProposed["Proposed, not in the code today"]:::proposed
        LegendFrom["A"] -->|"call or data flow"| LegendTo["B"]
        LegendProposedFrom["A"] -.->|"proposed call"| LegendProposedTo["B"]
    end

    subgraph ClientLayer["1. Client layer"]
        Browser["Web browser<br/>admins and stewards"]
        Mobile["StewardLog mobile app<br/>Expo 54, React Native 0.81<br/>FNR/"]
        SQLite[("expo-sqlite<br/>offline copy of site data")]
        SiteMap["Site map component, US 2.0.1 and 2.0.6<br/>components/map/SiteMap.tsx<br/>MapLibre GL, protected area polygons"]
    end

    subgraph AppLayer["2. Application layer: Vercel"]
        Next["Next.js 16 web app, webapp/<br/>pages, server actions,<br/>middleware.ts refreshes the session and sends<br/>signed-out users to /login (also /api;<br/>not /login, /signup, /auth, /error).<br/>Approval gate: an unapproved user gets GET /sites only,<br/>other pages redirect to /sites, API and POST get 403<br/>handlers /auth/callback, /auth/confirm"]
        Api["API route handlers<br/>webapp/app/api/<br/>S3 presign, galleries and image delete, profile,<br/>PDF, geocode, heatmap, OpenAPI"]
        KmlImport["KML import server action, US 6.0.1<br/>utils/kml-import-actions.ts<br/>parser lib/map/kmlImport.ts"]
        PdfJob["PDF job<br/>lib/pdf/processPdfJob.ts<br/>runs after the response"]
    end

    subgraph DataLayer["3. Data and storage layer"]
        subgraph Supabase["Supabase"]
            Auth["Supabase Auth<br/>sessions and OAuth sign-in"]
            Database[("PostgreSQL<br/>web app tables<br/>legacy tables: mobile app")]
            Storage[("Supabase Storage, bucket kml-imports<br/>private, 50 MiB, admin-only RLS")]
            Edge["Edge Functions get-users, add-user, delete-user<br/>source is not in this repository"]
        end
        S3[("AWS S3 bucket, ca-central-1<br/>inspection photos and PDF files")]
    end

    subgraph ExternalLayer["4. External services"]
        OAuth{{"OAuth providers<br/>Google, Microsoft Azure, GitHub"}}
        OpenCage{{"OpenCage Geocoding API"}}
        Protomaps{{"Protomaps basemap<br/>api.protomaps.com style and tiles<br/>needs NEXT_PUBLIC_PROTOMAPS_API_KEY"}}
        Osm{{"OpenStreetMap tiles<br/>admin dashboard heat map"}}
        GoogleMaps{{"Google My Maps embed"}}
        Cdn{{"cdnjs<br/>PDF.js, Leaflet marker icons"}}
        Fonts{{"Google Fonts<br/>Inter, DM Sans"}}
        INaturalist{{"iNaturalist API<br/>US 4.0.5, US 4.0.7"}}:::proposed
    end

    subgraph ToolingLayer["5. Build and documentation tooling"]
        GitHub["GitHub repository"]
        Actions["GitHub Actions<br/>push: Jest, MkDocs build, hook tests<br/>pull_request: PR checks, labeler, reviewer gate,<br/>diagrams (generate, render, push)"]
        Pages{{"GitHub Pages<br/>project documentation"}}
    end

    subgraph LocalDev["Local development only: npm run dev"]
        LocalSupabase["scripts/local_supabase.js<br/>Supabase CLI local stack, seed.sql, local admin user"]
        LocalS3[("scripts/local_s3.js<br/>LocalStack S3 through lstk<br/>s3.localhost.localstack.cloud:4566")]
    end

    Browser -->|"HTTPS: pages and server actions"| Next
    Browser -->|"fetch /api/*"| Api
    Browser -->|"PUT file with presigned URL"| S3
    Browser -->|"loads on /sites and /admin/sites"| SiteMap
    SiteMap -->|"map style and vector tiles (API key in the URL)"| Protomaps
    Browser -->|"heat map tiles (Leaflet)"| Osm
    Browser -->|"marker icons"| Cdn
    Browser -->|"web fonts, globals.css"| Fonts
    Browser -->|"upload .kml/.kmz (supabase-js)"| Storage

    Next -->|"supabase-js: sign in, session cookies;<br/>Admin API with service role (create, delete, approve users)"| Auth
    Next -->|"supabase-js: queries"| Database
    Next -->|"AWS SDK: delete objects (SIR rollback)"| S3
    Next -->|"server action getProtectedAreaBoundaries: GeoJSON"| SiteMap
    Next -->|"server action"| KmlImport
    KmlImport -->|"download and remove (service role)"| Storage
    KmlImport -->|"upsert protected_areas"| Database
    Api -->|"supabase-js: queries"| Database
    Api -->|"AWS SDK: presigned PUT and GET URLs, delete objects"| S3
    Api -->|"geocode an address"| OpenCage
    Api -->|"start job with after()"| PdfJob
    PdfJob -->|"read report data"| Database
    PdfJob -->|"read images, write PDF file"| S3
    Api -.->|"proposed: photo import, top observations"| INaturalist

    Auth -->|"OAuth redirect"| OAuth

    Mobile -->|"supabase-js: sign in"| Auth
    Mobile -->|"supabase-js: read and write legacy tables"| Database
    Mobile -->|"admin screens: create and delete users"| Edge
    Edge --> Auth
    Mobile -->|"cache and read offline"| SQLite
    Mobile -->|"geocode site names"| OpenCage
    Mobile -->|"WebView map"| GoogleMaps
    Mobile -->|"PDF.js in WebView"| Cdn

    GitHub -->|"push"| Actions
    Actions -->|"deploy docs on push to main"| Pages

    LocalSupabase -.->|"local only: replaces hosted Supabase"| Next
    LocalS3 -.->|"local only: AWS_ENDPOINT_URL_S3"| Next

