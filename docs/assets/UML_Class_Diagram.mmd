            <<webapp/services/auth.ts>>
            +login(email, password) success, error
            +signup(email, password) success, error, needsConfirmation
            +signInWithGoogle() success, error
            +signInWithMicrosoft() success, error
            +logout() void [CHANGE 5.0.4]
            +requestPasswordReset(email) void [NEW 5.0.2]
            +verifyResetCode(email, code) Session [NEW 5.0.2]
            +updatePassword(newPassword) void [NEW 5.0.2]
        }

        class AuthorizationService {
