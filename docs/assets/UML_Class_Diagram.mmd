    SiteSafetyPriorityActions --> AuthorizationService : Admin for writes
    GeometryLoadJob --> AuthorizationService : Admin
    GpxTrackActions --> AuthorizationService : signed-in user
    ImageDeleteRoute --> AuthorizationService : Admin
    PdfRoute --> AuthorizationService : owner or Admin
    PdfStatusRoute --> AuthorizationService : job creator or Admin
    SiteSafetyPriorityActions --> AuthorizationService : signed-in user for reads
    ExportRoutes --> AuthorizationService : Admin
    SiteQueries --> SupabaseBackend : W26 tables
    InspectionQueries --> SupabaseBackend : W26 tables
    ProfileService --> SupabaseBackend : W26 tables
    GeometryLoadJob --> SupabaseBackend : W26_kml_sites, W26_sites-pa
    GpxTrackActions --> SupabaseBackend : W26_gpx_tracks
