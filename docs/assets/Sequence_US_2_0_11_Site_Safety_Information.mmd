config:
  theme: base
  sequence:
    actorMargin: 75
    boxMargin: 12
    diagramMarginX: 45
    diagramMarginY: 30
    messageMargin: 40
    noteMargin: 16
    mirrorActors: false
    width: 190
    height: 90
  themeVariables:
    background: "#ffffff"
    primaryColor: "#69a8ef"
    primaryBorderColor: "#333333"
    primaryTextColor: "#111111"
    actorBkg: "#69a8ef"
    actorBorder: "#333333"
    actorTextColor: "#111111"
    actorLineColor: "#555555"
    signalColor: "#333333"
    signalTextColor: "#111111"
    activationBkgColor: "#cdd3db"
    activationBorderColor: "#cdd3db"
    noteBkgColor: "#ffe344"
    noteBorderColor: "#d4ba24"
    noteTextColor: "#111111"
    labelBoxBkgColor: "#ffffff"
    labelBoxBorderColor: "#555555"
