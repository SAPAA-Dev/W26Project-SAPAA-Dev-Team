        text error
        timestamptz created_at
    }

    people["WEB people"] {
        bigint id PK
        uuid auth_user_id FK, UK
        text display_name
        text[] skills
        text[] focus_areas
        integer activity_points "users cannot edit it (1.0.5)"
        timestamptz created_at
        timestamptz updated_at
    }

    site_stewards["WEB site_stewards"] {
        bigint site_id PK, FK
        bigint steward_id FK
        uuid assigned_by FK
        timestamptz assigned_at
    }

    protected_areas["WEB protected_areas"] {
        bigint id PK
        text name
        text oc_name
        text area_type
        text subtype
        text status
        text source
        text iucn
        text oc_no
        numeric acres
        numeric hectares
        date oc_date
        date date_est
        text notes
        jsonb geometry "GeoJSON MultiPolygon"
        timestamptz created_at
        timestamptz updated_at
        text folder "unique (folder, fid); KML Folder name"
        bigint fid "unique (folder, fid)"
        date date_res
        numeric area_ha
    }

    socials["WEB socials"] {
        bigint person_id PK, FK
        text email
        text phone
        text website
        text instagram
        text facebook
        text x
        text linkedin
        timestamptz updated_at
    }

    site_page_fields["WEB site_page_fields"] {
