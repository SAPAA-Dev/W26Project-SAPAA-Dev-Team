---
config:
  layout: elk
---
erDiagram
    %% CURRENT SCHEMA: WEB APP (verified against the code on 2026-09-28)
    %% One Supabase database holds two inspection systems:
    %%   WEB    = form_responses, answers, sites_pa, S26_pdf_jobs, and others. Used only by webapp/.
    %%   LEGACY = inspectheader, inspectdetails, and others. Used by FNR/ and
    %%            googleSheets/code.gs. See ER_Diagram_Legacy.mmd.
    %%   SHARED = luperson. The only table that all three clients use.
    %% Data in one system is not visible in the other system.

    %% Rules for this diagram:
    %% - A column is shown only if the code reads or writes it. Evidence:
    %%   webapp/utils/supabase/queries.ts, webapp/utils/form-actions.ts,
    %%   webapp/app/api/, webapp/lib/pdf/, and the local schema
    %%   webapp/supabase/migrations/20260925000000_local_app_schema.sql.
    %% - The production database can have more columns. They are not shown.
    %% - Mermaid does not allow spaces or hyphens in names. The quoted comment
    %%   gives the real column name when it is different.
    %% - The web app keys users by auth.users.id. It uses luperson only to check
    %%   if an email belongs to a steward (queries.ts:349-359). There is no
    %%   foreign key between auth.users and luperson.

    %% Tables that the earlier diagram showed but the code does not use:
    %% luperson, lumembertype, types, typessub,
    %% naturalregion, naturalregionsub, questions_category,
    %% recreational_activities and their join tables. They can exist in
    %% the database. They are not shown because no code uses them.
    direction LR

    auth_users["AUTH auth.users"] {
        uuid id PK
        text email
        text phone
        jsonb raw_user_meta_data "role, authenticated, full_name, avatar_url"
    }

    luperson["SHARED luperson"] {
        bigint id PK
        text email "web app reads"
    }

    sites_pa["WEB sites_pa"] {
        bigint id PK
        text namesite
        bigint ab_county FK
        boolean is_active
    }

    ab_counties["WEB ab_counties"] {
        bigint id PK
        text county
    }

    form_responses["WEB form_responses"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK
        text inspection_no
        date inspection_date
        boolean is_active
        timestamptz created_at
    }

    answers["WEB answers"] {
        bigint id PK
        bigint response_id FK
        bigint question_id FK
        text obs_value
        text obs_comm
    }

    questions["WEB questions"] {
        bigint id PK
        text question_key "question key"
        bigint question_key_id FK
        bigint section_id FK
        text form_question
        text subtext
        text question_type
        boolean is_required
        boolean is_active
        text autofill_key
        integer formorder
        boolean obs_value
        boolean obs_comm
    }

    question_keys["WEB question_keys"] {
        bigint id PK
        text question_key "question key"
        text category "one character, no FK in code"
        boolean comment
        text definition
    }

    question_options["WEB question_options"] {
        bigint id PK
        bigint question_id FK
        text option_text
        boolean is_active
        integer position
    }

    form_sections["WEB form_sections"] {
        bigint id PK
        text title
        text description
        text header
    }

    attachments["WEB attachments"] {
        bigint id PK
        bigint response_id FK
        bigint question_id FK
        bigint site_id FK
        text storage_key "S3 object key"
        text filename
        text content_type
        bigint file_size_bytes
        text caption
        text description
        text photographer
        text identifier
        date date
        timestamptz created_at
    }

    homepage_image_uploads["WEB homepage_image_uploads"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK
        text storage_key "S3 object key"
        text filename
        text content_type
        bigint file_size_bytes
        text caption
        text photographer
        text identifier
        date date
        timestamptz created_at
    }

    S26_pdf_jobs["WEB S26_pdf_jobs"] {
        uuid id PK
        uuid created_by FK
        text mode
        jsonb request_payload
        text status "pending, processing, complete, failed"
        text storage_path "S3 key of the PDF"
        text error
        timestamptz created_at
    }

    ab_counties |o--o{ sites_pa : "ab_county"
    sites_pa ||--o{ form_responses : "site_id"
    auth_users |o--o{ form_responses : "user_id"
    form_responses ||--o{ answers : "response_id"
    questions ||--o{ answers : "question_id"
    form_sections ||--o{ questions : "section_id"
    question_keys |o--o{ questions : "question_key_id"
    questions ||--o{ question_options : "question_id"
    form_responses |o--o{ attachments : "response_id"
    questions |o--o{ attachments : "question_id"
    sites_pa |o--o{ attachments : "site_id"
    sites_pa ||--o{ homepage_image_uploads : "site_id"
    auth_users |o--o{ homepage_image_uploads : "user_id"
    auth_users ||--o{ S26_pdf_jobs : "created_by"

    classDef auth fill:#e8e8e8,stroke:#333,color:#111
    classDef shared fill:#c9f7d4,stroke:#333,color:#111
    classDef web fill:#cfe4ff,stroke:#333,color:#111

    class auth_users auth
    class luperson shared
    class sites_pa,ab_counties,form_responses,answers,questions,question_keys,question_options,form_sections,attachments,homepage_image_uploads,S26_pdf_jobs web

