    sites_pa["WEB sites_pa"] {
        bigint id PK
        text namesite UK
        bigint ab_county FK
        boolean is_active
        timestamptz archived_at
        bigint protected_area_id FK, UK "optional protected_areas.id"
    }

    form_sections["WEB form_sections"] {
        bigint id PK
        text title UK
        text description
        text header
    }

    question_keys["WEB question_keys"] {
        bigint id PK
        text category "one character, no FK in code"
        text question_key UK "question key"
        boolean comment
        text definition
    }

    questions["WEB questions"] {
        bigint id PK
        text question_key UK "question key"
        bigint question_key_id FK
        bigint section_id FK
        text form_question
        text subtext
        text question_type
        boolean is_required
        boolean is_active
        text autofill_key
        integer formorder
        boolean obs_value
        boolean obs_comm
    }

    question_options["WEB question_options"] {
        bigint id PK
        bigint question_id FK "unique (question_id, option_text)"
        text option_text "unique (question_id, option_text)"
        boolean is_active
        integer position
    }

    form_responses["WEB form_responses"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK
        text inspection_no UK
        date inspection_date
        timestamptz created_at
        boolean is_active
        timestamptz archived_at
    }

    answers["WEB answers"] {
        bigint id PK
        bigint response_id FK
        bigint question_id FK
        text obs_value
        text obs_comm
    }

    attachments["WEB attachments"] {
        bigint id PK
        bigint response_id FK
        bigint question_id FK
        bigint site_id FK
        text storage_key "S3 object key"
        text filename
        text content_type
        bigint file_size_bytes
        text caption
        text description
        text photographer
        text identifier
        date date
        timestamptz created_at
    }

    homepage_image_uploads["WEB homepage_image_uploads"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK
        text storage_key "S3 object key"
        text filename
        text content_type
        bigint file_size_bytes
        date date
        text photographer
        text identifier
        text caption
        timestamptz created_at
    }

    luperson["SHARED luperson"] {
        bigint id PK
        text email UK
    }

    S26_pdf_jobs["WEB S26_pdf_jobs"] {
        uuid id PK
        uuid created_by FK
        text mode
        jsonb request_payload
        text status "pending, processing, complete, failed"
