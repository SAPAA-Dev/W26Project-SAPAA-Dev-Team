---
config:
  layout: elk
---
erDiagram
    %% PROPOSED SCHEMA: WEB APP AFTER THE 35 CURRENT USER STORIES
    %% Source: docs/user-stories.md (Sep 25 2026 stories and the stories of #42). This is a proposal, not
    %% the database. The current schema is in ER_Diagram.mmd (web app) and
    %% ER_Diagram_Legacy.mmd (mobile app and Google Sheets).

    %% How to read this diagram:
    %% - A table name that starts with EXISTING is in the database now.
    %% - A table name that starts with NEW is proposed. It shows the stories.
    %% - In an EXISTING table, a column with "NEW US x.y.z" is proposed.
    %%   Other columns exist now. Existing tables show only the key columns
    %%   and the columns that a story uses.
    %% - All proposed items are in the web app system. No story
    %%   needs a change to luperson or to the legacy tables.

    %% Stories that need no new table or column:
    %% - US 1.0.4 activity stats: count form_responses and answers.
    %% - US 2.0.3 deactivate and reactivate: sites_pa.is_active exists.
    %% - US 2.0.4 delete a site: delete all Site-owned rows and their S3 files.
    %%   Preserve the shared KML source and user profiles.
    %% - US 2.0.6 filter by county, US 2.0.8 site details from the map.
    %% - US 4.0.2 offline map layers: tiles stay in browser storage only.
    %% - US 4.0.4 edit own SIR: the edit page exists; ownership is user_id.
    %% - US 4.0.6 optional identifier: attachments.identifier can be NULL.
    %% - US 5.0.2 password reset, US 5.0.4 sign out: Supabase Auth.
    %% - US 7.0.1 steward PDF export: S26_pdf_jobs exists; the access rule
    %%   changes.
    %% - US 7.0.3 all-SIR summary, US 7.0.4 one question across years:
    %%   queries on answers, grouped by the question key (Q-number).
    %% - US 4.0.7 top iNaturalist observations: live call to iNaturalist.
    %% - US 7.0.6 export more than 50 SIRs, US 7.0.7 hide fields: S26_pdf_jobs
    %%   request_payload keeps selectedResponseIds and hiddenQuestionIds.
    %% - US 7.0.8 delete a SIR: delete the form_responses row with its
    %%   answers and attachments rows in one transaction.
    %% - US 7.0.5 delete an image: delete the attachments or
    %%   homepage_image_uploads row and the S3 object.

    %% US 6.0.1 AT 4: fallback geocoding results are cached and OpenCage
    %% requests stay under 2,500 per day. Where the cache and the daily count
    %% are stored is not decided. See the OPEN QUESTIONS box.
    %% The role store is not decided. See the OPEN QUESTIONS box.
    %% Open question for US 6.0.1 and 2.0.2: load the KML into a table, or
    %% read the KML file each time. kml_sites is the proposed option.
    %% US 2.0.10: the legacy table sites_report_fnr_test already has sapaaweb
    %% and inatmap (FNR/src/services/database.ts:503). It is a possible source
    %% for the new links.

    auth_users["EXISTING auth.users"] {
        uuid id PK
        text email
        jsonb raw_user_meta_data "full_name, role and authenticated today, the user can change it"
    }

    OPEN_QUESTIONS["OPEN QUESTIONS: NOT DECIDED"] {
        text role_store "Where the Admin or Steward role is kept. Today: raw_user_meta_data"
        text role_store_need "Sequence diagrams need a role that the user cannot change"
        text geocode_cache "US 6.0.1 AT 4: store for cached OpenCage results"
        text geocode_daily_count "US 6.0.1 AT 4: store for the daily request count, limit 2,500"
    }

    profiles["NEW profiles (US 1.0.1, 1.0.2)"] {
        uuid user_id PK, FK "auth.users.id"
        text display_name "required, US 1.0.2"
        text contact_email "required, US 1.0.2"
        text_array skills "US 1.0.1, 1.0.2"
        text_array focus_areas "US 1.0.1, 1.0.2"
        text inat_username "US 4.0.5"
    }

    profile_hidden_questions["NEW profile_hidden_questions (US 1.0.3)"] {
        uuid user_id PK, FK "profiles.user_id"
        bigint question_id PK, FK "answers others cannot see"
    }

    ab_counties["EXISTING ab_counties"] {
        bigint id PK
        text county
    }

    sites_pa["EXISTING sites_pa"] {
        bigint id PK
        text namesite "US 2.0.2 duplicate warning"
        bigint ab_county FK "US 2.0.6"
        boolean is_active "US 2.0.3"
        geometry boundary "NEW US 6.0.1, 2.0.1, 2.0.2: polygon, SRID 4326"
        numeric latitude "NEW US 6.0.1: centre point"
        numeric longitude "NEW US 6.0.1: centre point"
        text source_feature_id FK "NEW US 6.0.1: NULL = unmatched (AT 3)"
        text sapaaweb "NEW US 2.0.10: legacy sites_report_fnr_test has it"
        text inatmap "NEW US 2.0.10: legacy sites_report_fnr_test has it"
        uuid designated_steward_id FK "NEW US 3.0.2"
    }

    kml_sites["NEW kml_sites (US 6.0.1, 2.0.2): proposed option"] {
        text source_feature_id PK "ID of the placemark in the Alberta KML"
        text name
        geometry boundary "as in the KML, SRID 4326"
        timestamptz loaded_at
    }

    site_page_fields["NEW site_page_fields (US 2.0.5)"] {
        bigint id PK
        bigint site_id FK
        text label
        text value
        boolean is_visible "include or exclude on the site page"
        integer position
        uuid provided_by_steward_id FK "NEW US 2.0.5: profiles.user_id"
        bigint source_response_id FK "NEW US 2.0.5: optional source SIR"
    }

    gpx_tracks["NEW gpx_tracks (US 2.0.9, 2.0.1)"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK
        text storage_key "S3 key of the .gpx file"
        text filename
        bigint file_size_bytes "limit is checked"
        integer point_count "more than 0"
        timestamptz created_at
    }

    activity_point_values["NEW activity_point_values (US 1.0.5)"] {
        bigint site_id PK, FK
        text activity PK "sir_submitted, photo_uploaded"
        integer points
    }

    activity_points["NEW activity_points (US 1.0.5)"] {
        bigint id PK
        uuid user_id FK "auth.users.id"
        bigint site_id FK
        text activity
        bigint source_id "response or upload id, unique with activity"
        integer points
        timestamptz created_at
    }

    site_safety["NEW site_safety (US 2.0.11)"] {
        bigint site_id PK, FK
        text nearest_hospital "NULL = not recorded"
        text hazards "NULL = not recorded"
        text other_info "NULL = not recorded"
        uuid updated_by FK "auth.users.id"
        timestamptz updated_at
    }

    site_priority["NEW site_priority (US 2.0.12, 2.0.13)"] {
        bigint site_id PK, FK
        integer abuse_points
        integer biological_points
        integer time_since_visit_points
        timestamptz points_saved_at "US 2.0.13: reminder after one year"
        uuid saved_by FK "auth.users.id"
    }

    form_responses["EXISTING form_responses"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK "US 1.0.3, 4.0.4, 7.0.1"
        date inspection_date "US 7.0.3, 7.0.4"
        boolean is_active "US 7.0.5: files stay when false"
    }

    answers["EXISTING answers"] {
        bigint id PK
        bigint response_id FK
        bigint question_id FK
        text obs_value
        text obs_comm
    }

    questions["EXISTING questions"] {
        bigint id PK
        text question_key "question key, holds the Q-number"
        text form_question
    }

    attachments["EXISTING attachments"] {
        bigint id PK
        bigint response_id FK
        bigint site_id FK
        text storage_key "US 3.0.3, 7.0.5"
        text identifier "US 4.0.6: optional"
        bigint inat_observation_id "NEW US 4.0.5: photo is copied to S3"
    }

    homepage_image_uploads["EXISTING homepage_image_uploads"] {
        bigint id PK
        bigint site_id FK
        uuid user_id FK
        text storage_key "US 3.0.3, 7.0.5"
    }

    S26_pdf_jobs["EXISTING S26_pdf_jobs"] {
        uuid id PK
        uuid created_by FK "US 7.0.1"
        jsonb request_payload
        text status
        text storage_path
    }

    export_jobs["NEW export_jobs (US 3.0.3)"] {
        uuid id PK
        uuid created_by FK "auth.users.id"
        text status "pending, processing, complete, failed"
        text storage_path "S3 key of the zip"
        text error
        timestamptz created_at
    }

    auth_users ||--o| profiles : "user_id"
    profiles ||--o{ profile_hidden_questions : "user_id"
    questions ||--o{ profile_hidden_questions : "question_id"
    profiles |o--o{ sites_pa : "designated_steward_id"
    ab_counties |o--o{ sites_pa : "ab_county"
    kml_sites |o--o{ sites_pa : "source_feature_id"
    sites_pa ||--o{ site_page_fields : "site_id"
    profiles |o--o{ site_page_fields : "provided_by_steward_id"
    form_responses |o--o{ site_page_fields : "source_response_id"
    sites_pa ||--o{ gpx_tracks : "site_id"
    auth_users ||--o{ gpx_tracks : "user_id"
    sites_pa ||--o{ form_responses : "site_id"
    auth_users |o--o{ form_responses : "user_id"
    form_responses ||--o{ answers : "response_id"
    questions ||--o{ answers : "question_id"
    form_responses |o--o{ attachments : "response_id"
    sites_pa |o--o{ attachments : "site_id"
    sites_pa ||--o{ homepage_image_uploads : "site_id"
    auth_users |o--o{ homepage_image_uploads : "user_id"
    auth_users ||--o{ S26_pdf_jobs : "created_by"
    auth_users ||--o{ export_jobs : "created_by"
    sites_pa ||--o{ activity_point_values : "site_id"
    sites_pa ||--o{ activity_points : "site_id"
    auth_users ||--o{ activity_points : "user_id"
    sites_pa ||--o| site_safety : "site_id"
    sites_pa ||--o| site_priority : "site_id"

    classDef existing fill:#cfe4ff,stroke:#333,color:#111
    classDef proposed fill:#c9f7d4,stroke:#1a7f37,stroke-width:2px,color:#111
    classDef question fill:#ffe344,stroke:#d4ba24,stroke-width:2px,color:#111

    class auth_users,ab_counties,sites_pa,form_responses,answers,questions,attachments,homepage_image_uploads,S26_pdf_jobs existing
    class profiles,profile_hidden_questions,site_page_fields,gpx_tracks,kml_sites,export_jobs,activity_point_values,activity_points,site_safety,site_priority proposed
    class OPEN_QUESTIONS question

