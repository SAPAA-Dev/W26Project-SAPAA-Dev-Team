    FormResponse "1" *-- "0..*" Answer : response_id
    Question "1" <-- "0..*" Answer : question_id
    QuestionKey "0..1" <-- "0..*" Question : question_key_id
    FormSection "1" <-- "0..*" Question : section_id
    Question "1" *-- "0..*" QuestionOption : question_id
    FormResponse "0..1" *-- "0..*" Attachment : response_id
    Question "0..1" <-- "0..*" Attachment : question_id
    Site "0..1" <-- "0..*" Attachment : site_id
